# 复制此文件为 .env 并填写实际配置
# cp .env.example .env

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=clouddrive

# ===== JWT =====
# 用于签名 Token，请替换为随机长字符串
# 生成方法：python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a9ff73c0f5549943c9edfa2fef0fe29c88d048515e6789b9ed2d8ebf00ceda48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 文件存储 =====
UPLOAD_DIR=uploads
# 单个文件最大体积，单位字节，默认 2GB
MAX_FILE_SIZE=2147483648
# 每个用户存储配额，单位字节，默认 5GB
USER_QUOTA=5368709120

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
